+import assert from "node:assert/strict";
+import { test, type TestContext } from "node:test";
+import { sendIntent, wakeAndLaunch } from "../src/lib/remote";
+import { createCastOperation } from "./cast-service";
+
+const config = {
+  haUrl: "http://ha.test",
+  haToken: "test",
+  entityId: "media_player.fire_tv",
+};
+const intent = 'am start -a android.intent.action.VIEW -d "stremio:///detail/series/tt14688458" com.stremio.one';
+
+function homeAssistant(
+  t: TestContext,
+  options: {
+    bootAfter?: number;
+    launchError?: string;
+    dropped?: boolean;
+    foreground?: string;
+    transientForeground?: boolean;
+    state?: string;
+  } = {},
+) {
+  let elapsed = 0;
+  let response = "old-command-output";
+  let bootChecks = 0;
+  let foregroundChecks = 0;
+  const commands: string[] = [];
+  t.mock.method(Date, "now", () => elapsed);
+  t.mock.method(globalThis, "setTimeout", ((cb: () => void, delay: number) => {
+    elapsed += delay;
+    queueMicrotask(cb);
+    return 0;
+  }) as unknown as typeof setTimeout);
+  t.mock.method(globalThis, "fetch", async (url: string, init?: RequestInit) => {
+    if (init?.method === "POST") {
+      const body = JSON.parse(String(init.body)) as { command?: string };
+      if (body.command) {
+        const command = body.command;
+        commands.push(command);
+        let output = "";
+        let exit = 0;
+        if (command.includes("getprop sys.boot_completed")) {
+          bootChecks++;
+          exit = bootChecks >= (options.bootAfter ?? 1) ? 0 : 1;
+        }
+        if (command.includes("am start"))
+          output =
+            options.launchError ?? "Starting: Intent { dat=stremio:///detail/series/tt14688458 pkg=com.stremio.one }";
+        if (command.includes("dumpsys activity activities")) {
+          foregroundChecks++;
+          output =
+            options.foreground ??
+            (options.transientForeground && foregroundChecks === 1
+              ? "mResumedActivity: ActivityRecord{12 com.amazon.tv.launcher/.MainActivity}"
+              : "mResumedActivity: ActivityRecord{12 com.stremio.one/.MainActivity}");
+        }
+        const marker = command.match(/CAST_[a-f0-9]+/u)?.[0];
+        if (!options.dropped) response = marker ? `${output}\n${marker}:${exit}\n` : output;
+      }
+      return new Response("[]", { status: 200 });
+    }
+    assert.ok(url.includes(`/api/states/${config.entityId}`));
+    // A cached HA state can say 'on' while Android is still booting.
+    return Response.json({
+      entity_id: config.entityId,
+      state: options.state ?? "on",
+      attributes: { adb_response: response.trim() },
+    });
+  });
+  return {
+    commands,
+    bootChecks: () => bootChecks,
+    foregroundChecks: () => foregroundChecks,
+  };
+}
+
+test("HTTP 200 containing an Android launch error must fail", async (t) => {
+  homeAssistant(t, {
+    launchError: "Error: Activity not started, unable to resolve Intent",
+  });
+  await assert.rejects(sendIntent(config, intent), /launch|command|Android/i);
+});
+
+test("a silently dropped ADB command must not report success using stale output", async (t) => {
+  homeAssistant(t, { dropped: true });
+  await assert.rejects(sendIntent(config, intent), /confirm|response|ADB/i);
+});
+
+test("an HA state of on must not skip boot readiness; wake must never toggle power", async (t) => {
+  const ha = homeAssistant(t, { bootAfter: 3 });
+  await wakeAndLaunch(config, intent);
+  assert.equal(ha.bootChecks(), 3);
+  assert.ok(ha.commands.some((command) => command.includes("KEYCODE_WAKEUP")));
+  assert.ok(ha.commands.every((command) => !/input keyevent (26|3)\b/u.test(command)));
+  const launchIndex = ha.commands.findIndex((command) => command.includes("am start"));
+  assert.equal(
+    ha.commands.slice(0, launchIndex).filter((command) => command.includes("getprop sys.boot_completed")).length,
+    3,
+  );
+});
+
+test("boot timeout fails without ever launching the app", async (t) => {
+  const ha = homeAssistant(t, { bootAfter: Infinity });
+  await assert.rejects(wakeAndLaunch(config, intent), /ready|boot/i);
+  assert.ok(ha.commands.every((command) => !command.includes("am start")));
+});
+
+test("launch accepted but Fire TV stuck in launcher must fail", async (t) => {
+  homeAssistant(t, {
+    foreground: "mResumedActivity: ActivityRecord{12 com.amazon.tv.launcher/.MainActivity}",
+  });
+  await assert.rejects(sendIntent(config, intent), /foreground/i);
+});
+
+test("a background Stremio activity is not evidence that Stremio is open", async (t) => {
+  homeAssistant(t, {
+    foreground:
+      "Hist #0: ActivityRecord{12 com.stremio.one/.MainActivity}\nmResumedActivity: ActivityRecord{34 com.amazon.tv.launcher/.MainActivity}",
+  });
+  await assert.rejects(sendIntent(config, intent), /foreground/i);
+});
+
+test("successful launch waits for the target foreground activity", async (t) => {
+  const ha = homeAssistant(t, { transientForeground: true });
+  await sendIntent(config, intent);
+  assert.equal(ha.foregroundChecks(), 2);
+  assert.ok(ha.commands.some((command) => command.includes("am start -W")));
+});
+
+test("explicit component intents verify their package too", async (t) => {
+  const ha = homeAssistant(t, {
+    foreground: "topResumedActivity=ActivityRecord{12 com.limelight/.PcView}",
+  });
+  await sendIntent(config, "am start -n com.limelight/.PcView -f 0x10000020");
+  assert.equal(ha.foregroundChecks(), 1);
+});
+
+test("a stale unavailable HA state cannot toggle an already booted Fire TV off", async (t) => {
+  const ha = homeAssistant(t, { state: "unavailable" });
+  await wakeAndLaunch(config, intent);
+  assert.ok(ha.commands.some((command) => command.includes("KEYCODE_WAKEUP")));
+  assert.ok(ha.commands.every((command) => !/input keyevent 26\b/u.test(command)));
+});
+
+test("an app with a similar package suffix is not the target app", async (t) => {
+  homeAssistant(t, {
+    foreground: "mResumedActivity: ActivityRecord{12 other.com.stremio.one/.MainActivity}",
+  });
+  await assert.rejects(sendIntent(config, intent), /foreground/i);
+});
+
+test("Android SecurityException in a nominally successful command must fail", async (t) => {
+  homeAssistant(t, {
+    launchError: "java.lang.SecurityException: Permission Denial",
+  });
+  await assert.rejects(sendIntent(config, intent), /launch|Android/i);
+});
+
+test("Stremio cast operation reports failed when the device stays at the menu", async (t) => {
+  homeAssistant(t, {
+    foreground: "mResumedActivity: ActivityRecord{12 com.amazon.tv.launcher/.MainActivity}",
+  });
+  const cast = createCastOperation(
+    {
+      resolve: async () => ({
+        platform: "stremio",
+        title: "Silo",
+        intent,
+        url: "",
+      }),
+      launch: (command) => wakeAndLaunch(config, command),
+    },
+    ["stremio"],
+    "ES",
+  );
+  const result = await cast({ kind: "title", title: "Silo" }, () => {});
+  assert.equal(result.status, "failed");
+});
